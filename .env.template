# User Name (JARVIS will address you by this name)
USER_NAME=

# OpenRouter API Key (Get key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Model choice on OpenRouter (e.g. google/gemini-2.0-flash-001, openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct)
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Telegram Bot Token (Get from Telegram @BotFather)
TELEGRAM_BOT_TOKEN=

# Allowed Telegram User IDs (Security: Your numeric Telegram ID from @userinfobot, comma-separated)
ALLOWED_TELEGRAM_USERS=

# Security Password for Telegram Bot (required for /login in Telegram)
BOT_PASSWORD=

# ESP32 IP Address on local network or Tailscale mesh
ESP32_IP=

# Default workspace directory for AI actions (leave blank to auto-detect project folder)
DEFAULT_WORKSPACE=

# Windows PC Password (optional: used by /unlock to auto-type lockscreen password)
WINDOWS_PC_PASSWORD=
